# Acceptance thresholds — H200 SXM 8-GPU node (legacy profile)
#
# 标注同 b300_8gpu.env：[标准] / [推导] / [待校准]。
#
# 重要：甲方那份《验收标准》是给 B300 的，H200 没有对应的书面数值。本档案里
# 凡是 [待校准] 的项，都是按 B300 标准的"达标比例"套到 H200 标称规格上推出来的，
# 只保证不会把好机器误判 FAIL，**不足以作为合同依据**。首批 H200 实测后必须回填，
# 或直接以 OEM ATP 报告为准。

PROFILE_NAME="H200 SXM 8-GPU node (legacy)"
PROFILE_ARCH_NOTE="8 GPU + 4x NVSwitch3, 18x NVLink4/GPU"

# ---------------------------------------------------------------- 标称规格
NOMINAL_GPU_MEM_GIB=141            # 141GB HBM3e -> nvidia-smi 实测约 143771 MiB
NOMINAL_HBM_BW_TBS=4.8             # 官方显存带宽
NOMINAL_NVLINK_BIDIR_GBS=900       # NVLink4 每 GPU 900 GB/s 双向
NOMINAL_NVLINK_UNIDIR_GBS=450      # = 900 ÷ 2
NOMINAL_TDP_W=700
NOMINAL_DIMM_GIB=128

# ---------------------------------------------------------------- §1 物理与环境
EXPECTED_GPU_COUNT=8
EXPECTED_GPU_MODEL_PATTERN="H200"
# [标准] 总容量 ≥2TB。按十进制 TB 解读（更宽松的一侧）——
#        内存配置随订单变化（标准 §2 就举了 24×128GB 和 32×96GB 两种），
#        所以这里只保留标准给的下限，不假设具体配置。
#        真正抓"掉内存"靠下面两项，它们不依赖任何写死的容量：
#          SYS_MEM_DETECT_MIN_PCT  —— free 实测 / dmidecode 已装 的识别率
#          内存条一致性检查        —— 所有已装内存条的容量与频率是否一致
SYS_MEM_MIN_TB=2
# [推导] 内核保留通常 <1%，识别率低于 97% 说明有内存条没被认出来或已被 BIOS 屏蔽。
SYS_MEM_DETECT_MIN_PCT=97
# [推导] 系统内存压测（stressapptest）。标准没有明确要求，但 3TB 级 DDR5 不做压测
#        等于放过一整类隐患；默认与 §3 的 1 小时 GPU 压测同期进行。
#        设 0 可关闭。占用内存比例见 SYS_MEM_STRESS_PCT。
SYS_MEM_STRESS_SECONDS=1800
SYS_MEM_STRESS_PCT=80
GPU_TEMP_MAX_C=86                  # [待校准] 沿用 B300 标准值；H200 规格上限相同

# ------------------------------------------------------------ §3 GPU 硬件验证
# [推导] 141 GiB = 144384 MiB，nvidia-smi 实测 143771（99.6%）。
#        取标称 97% = 140052，可抓住坏 stack 缩水（-12.5%）而不误伤 ECC 保留。
GPU_MEM_MIN_MIB=140000
GPU_MEM_NOMINAL_GB=141
NODE_GPU_MEM_MIN_GIB=1093          # [推导] 8 × 140000 MiB ÷ 1024
ECC_MODE_EXPECTED="Enabled"
ECC_UNCORRECTED_MAX=0
ECC_CORRECTED_MAX=2
GPU_POWER_LIMIT_W=700
GPU_POWER_LIMIT_TOL_W=10
PCIE_GEN=5                         # H200 SXM: PCIe Gen5 x16
PCIE_WIDTH=16
# [待校准] Gen5 x16 理论 ~64 GB/s，pinned memory 实测约 52-55。取 45 作为
#          "链路没坏"的下限；要卡性能请以 OEM ATP 为准。
NVB_H2D_MIN_GBS=45
NVB_D2H_MIN_GBS=45
GPU_BURN_SHORT_SECONDS=3600

# ------------------------------------------------- §4 NVLink（节点内 / Rank 内）
# [待校准] 按 B300 标准的比例套用：单向标称 450 GB/s
#            D2D  ×85.6% = 385 ；P2P ×83.3% = 375
#          但 nvbandwidth/p2p 的实测值受拓扑与测法影响较大，这里各再留 8% 余量，
#          先保证不误判，首批实测后收紧。
NVB_D2D_READ_MIN_GBS=355
NVLINK_TOPO_TAG="NV18"             # H200 HGX 同样是每卡 18 条
# [推导] GPU 与其配对网卡可接受的 PCIe 邻近度。rail-optimized 8 卡 8 网卡设计中
#        GPU_i 应与 NIC_i 同域；PIX=至多一个 PCIe 桥，PXB=多个桥但不过 Host Bridge，
#        两者 GDR 都走本地 PCIe。NODE/PHB/SYS 要绕 Host Bridge 或 CPU 间互连(UPI)，
#        带宽掉三成以上，且 ibstat/nvidia-smi 全部正常 —— 只有 topo -m 能看出来。
GPU_NIC_AFFINITY_OK="PIX PXB"
NVLINK_LINKS_PER_GPU=18
NVLINK_ERR_MAX=0
P2P_BW_MIN_GBS=345
P2P_LAT_MAX_US=5
# [待校准] 8 卡 NVLink4 AllReduce Bus BW 典型 370-480 GB/s，取 350 作下限。
NCCL_ALLREDUCE_MIN_GBS=350
NCCL_ALLGATHER_MIN_GBS=290
NCCL_BENCH_ARGS="-b 512M -e 8G -f 2 -g 8"

# HBM 显存带宽（旧标准特有；需 bandwidthTest / DCGM memory_bandwidth 才能测）
# [标准] 来自 docs/acceptance_criteria.md v1.0：4.3 = 官方 4.8 的 90%，4.1 = 85%
HBM_BW_PASS_TBS=4.3
HBM_BW_RETEST_TBS=4.1

# ------------------------------------- §5 高性能网络（RoCE v2，多机轨道使用）
ROCE_LINK_TYPE=2
ROCE_MTU=9000
ROCE_TRUST_MODE="dscp"
# [待校准] 按 ConnectX-7 200Gb/s 单口，取线速 90% = 180。换 400G 口需重设。
ROCE_WRITE_BW_MIN_GBPS=180
ROCE_READ_BW_MIN_GBPS=180
ROCE_GDR_BW_MIN_GBPS=170
ROCE_LAT_MAX_US=3.0
ROCE_PFC_PAUSE_MAX_PCT=0.1
ROCE_RX_DISCARDS_MAX=0
ROCE_ONLY_ALLREDUCE_MIN_GBS=20
ROCE_PERFTEST_ARGS="-s 65536 -x 3 -q 4 --report_gbits"

# -------------------------------------------------------- §6 跨节点 NCCL 通信
# [待校准] 全部按 H200 单机 AllReduce 下限打折推算，无书面依据。
CLUSTER_ALLREDUCE_SCALE="2:300 4:290 8:280 16:270"
CLUSTER_ALLGATHER_2N_MIN_GBS=300
CLUSTER_REDUCESCATTER_2N_MIN_GBS=300
CLUSTER_ALLTOALL_2N_MIN_GBS=40
CLUSTER_SENDRECV_2N_MIN_GBS=20
CLUSTER_BENCH_ARGS="-b 512M -e 8G -f 2 -g 1"

# ------------------------------------------------- §6b 慢节点体检（拓扑感知）
# 与上面 §6 互补：§6 判"够不够快"（对绝对阈值），本节判"有没有拖后腿的"（对同批中位数）。
# 全员一起劣化时 §6 会 FAIL 而本节全绿；绝对达标但藏着一台差 15% 的机器时反过来。
# [推导] 容忍度 0.8 = 最多容忍 20% 衰减。取 0.8 而非更松，是因为单卡慢 20% 在
#        同步训练里会把整个 job 拖慢 20%，不是"略慢"。
CLUSTER_STRAGGLER_MIN_RATIO=0.8
# [推导] 节点聚合 pairwise 带宽绝对下限，兜住"全员一起劣化"。取 §6 中 2 节点
#        AllReduce 门槛的一半：pairwise 是单向点对点，拿不到集合通信的聚合效率。
#        0 表示禁用，但禁用等于放弃对整体劣化的检测，不建议。
CLUSTER_PAIRWISE_MIN_GBS=150
# [待校准] 算力绝对下限（TFLOPS，fp32 4096^3 GEMM）。用 TFLOPS 不用秒数：
#          秒数会随 PREFLIGHT_COMPUTE_ITERS 变化，改迭代数阈值就失效。
#          与相对比较配合：相对比较发现"批内不一致"，绝对下限兜住"整批一起劣化"。
#          首批实测后回填；填 0 等于放弃对整批劣化的检测。
CLUSTER_COMPUTE_MIN_TFLOPS=0
# [待校准] Ring P2P 带宽绝对下限（GB/s）。Ring **只对本阈值判定** ——
#          环形通信同步，一条慢链路把整个环拖平，各 rank 值几乎相同，
#          逐 rank 比中位数的判据结构上几乎不可能触发。
CLUSTER_RING_MIN_GBS=0
CLUSTER_STRAGGLER_MSG_MB=100                                    # [推导] 与 §6 的大消息段对齐
# [待校准] NCCL 走哪张网。原始脚本写死 eth0/ib7s 是某集群的值，换集群必炸；
#          留空则用 NCCL 自动探测（多网口机器上不可靠，建议现场填实）。
CLUSTER_NCCL_SOCKET_IFNAME=""
CLUSTER_NCCL_IB_HCA=""
# [待校准] 拓扑发现兜底：主机名里表示 pod/rack/leaf 的字段。
#          IB 有 iblinkinfo、RoCE 有 LLDP 时用不到这条。
CLUSTER_TOPO_HOST_REGEX=".*-(pod|rack|leaf)([0-9]+)-.*"
# [标准] 甲方要求计算网 1:1 无收敛。实测收敛比 = 组内成对带宽中位 / 跨组成对带宽中位。
#        取 1.2 而非 1.0：跨 leaf 多一跳交换，即使真无收敛也有几个百分点的自然损耗。
#        交换机配置看不出实际打流表现，这是唯一能证伪"1:1 无收敛"的实测依据。
CLUSTER_OVERSUBSCRIPTION_MAX=1.2

# ------------------------------------------------------------- §7 GPU 软件栈
DRIVER_MIN_VERSION="550.54"        # [待校准] H200 首个稳定支持版本
CUDA_MIN_VERSION="12.4"            # [待校准]
NCCL_MIN_VERSION="2.30"            # [推导] 同 B300：nccl-tests master 的符号要求
DCGM_MIN_VERSION="3.3"             # [推导] H200 由 DCGM 3.3.x 起支持
EXPECTED_COMPUTE_CAP="9.0"         # Hopper = sm_90
CUDA_ARCH_LIST="90"
REQUIRE_NVIDIA_PEERMEM=1
REQUIRE_GDRCOPY=0                  # H200 旧流程未要求
NVIDIA_MODPROBE_REQUIRED="NVreg_EnableStreamMemOPs=1 PeerMappingOverride=1"

# 离线包选择（相对 downloads/ 与 tools/）。
DRIVER_RUNFILE_GLOB="nvidia/NVIDIA-Linux-x86_64-*.run"
DCGM_DEB_GLOB="nvidia/datacenter-gpu-manager_3*.deb"
FABRICMANAGER_DEB_GLOB="nvidia/nvidia-fabricmanager-*.deb"
CUDA_RUNTIME_DEB_GLOB="offline_deb_noble/runtime/*.deb"
# 现有 tools/bin 就是 CUDA 12.8 / sm_90+sm_100 这一套。
TOOLS_BIN_SUBDIR="bin"

# ------------------------------------------------------------ 同批次比对
# [标准] 来自 docs/acceptance_criteria.md v1.0：
#   硬性 FAIL 条件 —— "同批次性能低于中位数 10% 以上"
#   §5.4 分级       —— >=95% 中位数 PASS；>=90% 且 <95% RETEST；<90% FAIL
# 用 scripts/compare_batch.sh 对多台机器的判定表做横向比对。
BATCH_PASS_PCT=95
BATCH_RETEST_PCT=90
# 少于这个台数时中位数没有统计意义，只列数据不判定
BATCH_MIN_MACHINES=3

# ---------------------------------------- §8 标准化算力基准与稳定性（长稳烤机）
SOAK_SECONDS=64800
SOAK_SAMPLE_INTERVAL_S=60
GPU_TEMP_FLUCT_MAX_C=5
# [推导] 温度波动只统计负载起来之后：采样器先于 gpu_burn 启动，第一个样本是空载温度
#        （实测 36 °C → 满载 56~59 °C），算进去单卡波动 23~26 °C，正常机器必判 FAIL。
#        600 s 覆盖升温段（实测 1 分钟内到稳态）且远小于 18 h，不影响抓长期漂移。
SOAK_TEMP_WARMUP_S=600
SOAK_XID_MAX=0
SOAK_NVLINK_CRC_DELTA_MAX=0
