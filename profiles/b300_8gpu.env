# Acceptance thresholds — B300 / GB300 (Blackwell Ultra) 8-GPU air-cooled node
#
# 每个阈值都标了【来源】，三类：
#   [标准]  甲方《验收标准》表格里的原值，不得擅改
#   [推导]  由标称规格 + 明确的判据推出来，注释里写清推导过程
#   [待校准] 首批机器实测后应当回填的经验值，现值只保证不误判
#
# 改阈值只改这里，脚本不含硬编码数值。与 docs/acceptance_criteria_b300.md 保持同步。

PROFILE_NAME="B300/GB300 Blackwell Ultra 8-GPU node"
PROFILE_ARCH_NOTE="8 GPU + 2x NVSwitch4, 18x NVLink5/GPU, 8x ConnectX-8, air-cooled 8U"

# ---------------------------------------------------------------- 标称规格
# 阈值从这些标称值推导；换 SKU 时先改这里。
NOMINAL_GPU_MEM_GIB=288            # 288GB HBM3e（NVIDIA 口径的 GB ≈ GiB）
NOMINAL_NVLINK_BIDIR_TBS=1.8       # NVLink5 每 GPU 1.8 TB/s 双向
NOMINAL_NVLINK_UNIDIR_GBS=900      # = 1.8 TB/s ÷ 2
NOMINAL_SYS_MEM_GIB=3072           # 24 × 128GiB DDR5 RDIMM
NOMINAL_DIMM_GIB=128
NOMINAL_TDP_W=1100

# ---------------------------------------------------------------- §1 物理与环境
EXPECTED_GPU_COUNT=8                                            # [标准] 每节点 8 颗
EXPECTED_GPU_MODEL_PATTERN="B300|GB300|Blackwell"
# [标准] 总容量 ≥3TB。按十进制 TB 解读（更宽松的一侧）——
#        内存配置随订单变化（标准 §2 就举了 24×128GB 和 32×96GB 两种），
#        所以这里只保留标准给的下限，不假设具体配置。
#        真正抓"掉内存"靠下面两项，它们不依赖任何写死的容量：
#          SYS_MEM_DETECT_MIN_PCT  —— free 实测 / dmidecode 已装 的识别率
#          内存条一致性检查        —— 所有已装内存条的容量与频率是否一致
SYS_MEM_MIN_TB=3
# [推导] 内核保留通常 <1%，识别率低于 97% 说明有内存条没被认出来或已被 BIOS 屏蔽。
SYS_MEM_DETECT_MIN_PCT=97
# [推导] 系统内存压测（stressapptest）。标准没有明确要求，但 3TB 级 DDR5 不做压测
#        等于放过一整类隐患；默认与 §3 的 1 小时 GPU 压测同期进行。
#        设 0 可关闭。占用内存比例见 SYS_MEM_STRESS_PCT。
SYS_MEM_STRESS_SECONDS=1800
SYS_MEM_STRESS_PCT=80
GPU_TEMP_MAX_C=86                                               # [标准] ≤86°C

# ------------------------------------------------------------ §3 GPU 硬件验证
# [推导] 288 GiB = 294912 MiB，nvidia-smi 扣除 ECC 保留后实测约 99.4%（≈293100）。
#        本项要抓的是"显存缩水"（坏 HBM stack 被屏蔽 = 少 1/8 = 12.5%），
#        取标称 97% = 286064，既不会被 ECC 保留误伤，也远高于缩水后的容量。
GPU_MEM_MIN_MIB=286000
GPU_MEM_NOMINAL_GB=288
# [推导] 8 × 上面的单卡下限 ÷ 1024 = 2234 GiB。单卡已单独判，这里是冗余校验。
NODE_GPU_MEM_MIN_GIB=2234
ECC_MODE_EXPECTED="Enabled"                                     # [标准]
ECC_UNCORRECTED_MAX=0                                           # [标准] = 0
ECC_CORRECTED_MAX=2                                             # [标准] 压测窗口内单卡 ≤2
GPU_POWER_LIMIT_W=1100                                          # [标准] 每卡 1100W
GPU_POWER_LIMIT_TOL_W=10                                        # [推导] 允许 ±10W 的读数抖动
PCIE_GEN=6                                                      # [标准] Gen6 x16
PCIE_WIDTH=16
NVB_H2D_MIN_GBS=55                                              # [标准] ≥55 GB/s
NVB_D2H_MIN_GBS=55                                              # [标准] ≥55 GB/s
GPU_BURN_SHORT_SECONDS=3600                                     # [标准] gpu_burn -tc 3600

# ------------------------------------------------- §4 NVLink（节点内 / Rank 内）
NVB_D2D_READ_MIN_GBS=770        # [标准] ≥770 GB/s 单向（= 标称 900 的 85.6%）
NVLINK_TOPO_TAG="NV18"          # [标准] 全互联 NV18
NVLINK_LINKS_PER_GPU=18         # [标准] 每卡 18 条 NVLink 5.0
NVLINK_ERR_MAX=0                # [标准] CRC / Replay = 0
P2P_BW_MIN_GBS=750              # [标准] 单向 ≥750 GB/s（= 标称 900 的 83.3%）
P2P_LAT_MAX_US=5                # [标准] ≤5 us
NCCL_ALLREDUCE_MIN_GBS=800      # [标准] Bus BW ≥800 GB/s
NCCL_ALLGATHER_MIN_GBS=650      # [标准] Bus BW ≥650 GB/s
NCCL_BENCH_ARGS="-b 512M -e 8G -f 2 -g 8"                       # [标准] 原样

# ------------------------------------- §5 高性能网络（RoCE v2，多机轨道使用）
ROCE_LINK_TYPE=2                                                # [标准] 2 = Ethernet
ROCE_MTU=9000                                                   # [标准]
ROCE_TRUST_MODE="dscp"                                          # [标准]
# 注意：ConnectX-8 单口 800Gb/s，460 更像 400G 单口的指标。此值按标准原样保留，
# 但如果现场确认是 800G 口，这条阈值形同虚设 —— 需要甲方书面确认。
ROCE_WRITE_BW_MIN_GBPS=460                                      # [标准]
ROCE_READ_BW_MIN_GBPS=460                                       # [标准]
ROCE_GDR_BW_MIN_GBPS=700                                        # [标准]
ROCE_LAT_MAX_US=3.0                                             # [标准]
ROCE_PFC_PAUSE_MAX_PCT=0.1                                      # [标准]
ROCE_RX_DISCARDS_MAX=0                                          # [标准]
ROCE_ONLY_ALLREDUCE_MIN_GBS=90                                  # [标准] 单 GPU Bus BW
ROCE_PERFTEST_ARGS="-s 65536 -x 3 -q 4 --report_gbits"          # [标准] 原样

# -------------------------------------------------------- §6 跨节点 NCCL 通信
# [标准] 格式 <节点数>:<最低 AllReduce Bus BW GB/s>，每节点 8 GPU
CLUSTER_ALLREDUCE_SCALE="2:720 4:700 8:680 16:660"
CLUSTER_ALLGATHER_2N_MIN_GBS=720                                # [标准]
CLUSTER_REDUCESCATTER_2N_MIN_GBS=750                            # [标准]
CLUSTER_ALLTOALL_2N_MIN_GBS=75                                  # [标准]
CLUSTER_SENDRECV_2N_MIN_GBS=30                                  # [标准] 每 GPU 双向
CLUSTER_BENCH_ARGS="-b 512M -e 8G -f 2 -g 1"                    # [标准] 原样

# ------------------------------------------------------------- §7 GPU 软件栈
#
# 不同 GPU 型号绑定不同的驱动/CUDA/NCCL/DCGM 版本，全部写在 profile 里；
# 安装脚本和采集脚本一律按 profile 取值，不得硬编码。
DRIVER_MIN_VERSION="580.105"    # [标准] ≥580.105 且全集群一致
CUDA_MIN_VERSION="13.0"         # [标准] ≥13.0
NCCL_MIN_VERSION="2.30"         # [推导] nccl-tests 需要 ncclTeamLsa / ncclDevCommCreate
DCGM_MIN_VERSION="4.0"          # [推导] Blackwell 需 DCGM 4.x；3.3.9 不识别 B300
# [待校准] Blackwell Ultra 预期计算能力。上机用 preflight.sh 实测确认；
#          若与 tools 二进制的 fatbin 架构不符，必须按 CUDA_ARCH_LIST 重编
#          （见 docs/cuda_arch_decision.md）。
EXPECTED_COMPUTE_CAP="10.3"
CUDA_ARCH_LIST="90;100;103"
REQUIRE_NVIDIA_PEERMEM=1                                        # [标准] 已加载
REQUIRE_GDRCOPY=1                                               # [标准] gdrcopy_sanity PASS
NVIDIA_MODPROBE_REQUIRED="NVreg_EnableStreamMemOPs=1 PeerMappingOverride=1"   # [标准]

# 离线包选择（相对 downloads/ 与 tools/）。留空表示沿用目录内唯一匹配项。
DRIVER_RUNFILE_GLOB="nvidia/NVIDIA-Linux-x86_64-6*.run"
DCGM_DEB_GLOB="nvidia/datacenter-gpu-manager-4*.deb"
FABRICMANAGER_DEB_GLOB="nvidia/nvidia-fabricmanager-*.deb"
CUDA_RUNTIME_DEB_GLOB="offline_deb_noble/runtime/*.deb"
# 该机型使用的预编译二进制集（tools/ 下的子目录）。不同 CUDA 线各一套，
# 不要混用：libcudart 版本必须和二进制链接的一致。
TOOLS_BIN_SUBDIR="bin_cuda13_sm90-100-103"

# ------------------------------------------------------------ 同批次比对
# [标准] 来自 docs/acceptance_criteria.md v1.0：
#   硬性 FAIL 条件 —— "同批次性能低于中位数 10% 以上"
#   §5.4 分级       —— >=95% 中位数 PASS；>=90% 且 <95% RETEST；<90% FAIL
# 用 scripts/compare_batch.sh 对多台机器的判定表做横向比对。
BATCH_PASS_PCT=95
BATCH_RETEST_PCT=90
# 少于这个台数时中位数没有统计意义，只列数据不判定
BATCH_MIN_MACHINES=3

# ---------------------------------------- §8 标准化算力基准与稳定性（长稳烤机）
# 标准第 8 章标题写 "24h"，命令写 -tc 64800（=18h），§3 的 ECC 那行也写 18h。
# 这里以命令为准；需要 24h 就设 SOAK_SECONDS=86400。签验收前应书面确认。
SOAK_SECONDS=64800                                              # [标准] -tc 64800
SOAK_SAMPLE_INTERVAL_S=60                                       # [标准] dmon -d 60
GPU_TEMP_FLUCT_MAX_C=5                                          # [标准] 波动 ≤5°C
SOAK_XID_MAX=0                                                  # [标准] 零 XID
SOAK_NVLINK_CRC_DELTA_MAX=0                                     # [标准] 零 CRC 增量
