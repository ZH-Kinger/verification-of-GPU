# Claude Code local session settings
.claude/

# Heavy artifacts are regenerated by bootstrap.sh — not tracked here.
downloads/iso/*.iso
downloads/nvidia/*.deb
downloads/nvidia/*.run
downloads/nvidia/Packages.*
downloads/offline_deb_noble/runtime/*.deb
downloads/offline_deb_noble/rebuild/*.deb
downloads/source/*.zip

# compiled stress binaries (keep the manifest)
tools/bin/*
!tools/bin/.gitkeep

# field output
logs/*
reports/*
inventory/*
!**/.gitkeep
